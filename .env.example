# Azure Entra ID Configuration
TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-azure-client-id  
CLIENT_SECRET=your-azure-client-secret
REDIRECT_URI=http://localhost:3001/auth/callback

# JWT Secrets (generate strong random strings)
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# --- Access-token signing ---------------------------------------------------
# HS256 (default) signs with ACCESS_TOKEN_SECRET above: every verifier needs a
# copy of that secret, which also lets it MINT tokens. RS256 publishes a public
# key at /.well-known/jwks.json so verifiers can validate without one.
#
# Generate a keypair:  node scripts/generate-jwt-keys.mjs
#
# Leave JWT_SIGNING_ALG unset to keep signing HS256 while still publishing the
# public key -- that lets consumers switch over before the issuer does.
JWT_SIGNING_ALG=HS256
# JWT_PRIVATE_KEY=      # RSA private key: PEM, base64 PEM, or PEM with \n escapes
# JWT_PUBLIC_KEY=       # optional; derived from the private key when omitted
# JWT_PREVIOUS_PUBLIC_KEYS=  # comma-separated retired public keys, kept in the
#                            # JWKS until tokens signed by them expire
# JWT_ISSUER=https://auth.example.com   # stamped as `iss` on RS256 tokens

# Database
MONGODB_URL=mongodb://localhost:27017/storm-gate


# Server Configuration
PORT=3001
NODE_ENV=development

# CORS allowlist — comma-separated list of consumer origins that may send credentialed requests.
# Required for cross-origin clients of @storm-gate/client (so /refresh_token cookie can roundtrip).
# Dev default (when unset) is localhost:3000,localhost:3003. MUST be set in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3003
