{
  "name": "@storm-gate/express",
  "version": "0.2.0",
  "description": "Express middleware for verifying Storm-Gate-issued JWTs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:exports": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "express": ">=4.17 <6",
    "jsonwebtoken": ">=9 <10"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "keywords": [
    "storm-gate",
    "express",
    "jwt",
    "auth",
    "middleware"
  ],
  "author": "Dominique Hosea",
  "license": "MIT",
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoseaCodes/Storm-Gate.git"
  },
  "bugs": {
    "url": "https://github.com/HoseaCodes/Storm-Gate/issues"
  },
  "homepage": "https://github.com/HoseaCodes/Storm-Gate#readme"
}
