{
  "name": "storm-gate",
  "version": "1.9.1-rc.2",
  "description": "",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node src/server.js",
    "start:lambda": "node src/lambda-app.js",
    "dev": "nodemon src/server.js",
    "dev:lambda": "nodemon src/lambda-app.js",
    "secrets": "sh scripts/getEnvVars.sh",
    "test": "vitest run",
    "test:oidc": "node test-oidc.js",
    "build": "echo 'No build step required for Node.js app'",
    "build:packages": "npm run build --workspaces --if-present",
    "test:packages": "npm run test --workspaces --if-present",
    "check:packages": "npm run check:exports --workspaces --if-present",
    "changeset": "changeset",
    "release": "npm run build:packages && changeset publish",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Dominique Hosea",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "openid-client": "^6.5.3",
    "path": "^0.12.7",
    "serverless-http": "^3.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "nodemon": "^3.1.0",
    "publint": "^0.2.12",
    "semantic-release": "24.2.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
